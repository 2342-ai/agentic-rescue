#!/usr/bin/env bash
# rescue: welcome screen and menu of the Agentic Rescue console.
#   rescue              the menu
#   rescue boot         first login on the console: welcome, then the menu
#   rescue welcome      logo, one-line intro and status
#   rescue help         the commands and keys, as shown when leaving the menu
#   rescue agent [NAME] start opencode, claude or codex
#   rescue --help
set -euo pipefail

POPUP=0
if [[ ${RESCUE_POPUP:-} == 1 ]]; then POPUP=1; fi

C_DIM=$'\e[38;2;86;95;137m' C_TXT=$'\e[38;2;192;202;245m' C_KEY=$'\e[38;2;122;162;247m'
C_ACC=$'\e[38;2;176;109;255m' C_OFF=$'\e[0m' C_BOLD=$'\e[1m'

# gum look shared by every prompt.
export GUM_CHOOSE_CURSOR="› " GUM_CHOOSE_CURSOR_FOREGROUND="#7aa2f7" GUM_CHOOSE_SELECTED_FOREGROUND="#7aa2f7"
export GUM_CHOOSE_HEADER_FOREGROUND="#565f89" GUM_CHOOSE_ITEM_FOREGROUND="#c0caf5"
export GUM_CONFIRM_PROMPT_FOREGROUND="#c0caf5" GUM_CONFIRM_SELECTED_BACKGROUND="#7aa2f7" GUM_CONFIRM_SELECTED_FOREGROUND="#1a1b26"
export GUM_INPUT_CURSOR_FOREGROUND="#7aa2f7" GUM_INPUT_PROMPT_FOREGROUND="#7aa2f7"

version() {
  if [[ -r /iso/version.txt ]]; then cat /iso/version.txt; else echo dev; fi
}

welcome() {
  echo
  rescue-logo
  local name
  name=$(rescue-config get name 2>/dev/null || true)
  if [[ -z $name || $name == null ]]; then name=""; else name=" · $name"; fi
  printf '  %sagentic rescue%s %s· 2342.ai · v%s%s%s\n\n' "$C_ACC" "$C_OFF" "$C_DIM" "$(version)" "$name" "$C_OFF"
  printf '  %sA live NixOS console with rescue tools and AI agents.%s\n' "$C_TXT" "$C_OFF"
  printf '  %sNothing here touches your disks until you ask it to.%s\n\n' "$C_DIM" "$C_OFF"
  printf '  '
  rescue-status --line
  echo
}

show_help() {
  local row
  printf '  %s%sCommands%s\n' "$C_BOLD" "$C_TXT" "$C_OFF"
  while IFS='|' read -r cmd what key; do
    printf -v row '  %s%-25s%s %s%-50s%s %s%s%s' "$C_KEY" "$cmd" "$C_OFF" "$C_TXT" "$what" "$C_OFF" "$C_DIM" "$key" "$C_OFF"
    printf '%s\n' "$row"
  done <<'ROWS'
rescue|this menu|C-Space m
impala|connect to Wi-Fi (Ethernet just works)|C-Space w
rescue-mount|find, unlock and mount the installed system|read-only
rescue-enter|run a shell inside the installed system|chroot
rescue-connect|add an API key, or sign in to an agent|C-Space k
rescue-share|drive this console from a phone browser|C-Space s
opencode  claude  codex|start an agent and describe what is broken|C-Space a
ROWS
  printf '\n  %s%-25s%s %s%-50s%s\n' "$C_KEY" "C-Space u" "$C_OFF" "$C_TXT" "send the last link on screen to your phone" "$C_OFF"
  printf '  %s%-25s%s %s%-50s%s\n\n' "$C_KEY" "C-Space ?" "$C_OFF" "$C_TXT" "all keys" "$C_OFF"
}

keys() {
  printf '  %s%sKeys%s %s(prefix C-Space)%s\n\n' "$C_BOLD" "$C_TXT" "$C_OFF" "$C_DIM" "$C_OFF"
  while IFS=';' read -r k what; do
    printf '  %s%-10s%s %s%s%s\n' "$C_KEY" "$k" "$C_OFF" "$C_TXT" "$what" "$C_OFF"
  done <<'ROWS'
m;menu
a;start an agent in a new window
k;connect an AI provider
u;send the last link on screen to your phone
s;share this console with a phone
w;Wi-Fi (impala)
c;new window
n / p;next / previous window
| / -;split right / down
d;detach (over ssh: tmux attach -t rescue)
ROWS
  echo
}

pause() {
  printf '\n  %sEnter: back to the menu%s ' "$C_DIM" "$C_OFF"
  read -r _ || true
}

providers_configured() {
  local state
  state=$(rescue-config state 2>/dev/null || echo '{}')
  jq -e '((.providers // []) | length > 0) or .inference == true' <<<"$state" >/dev/null
}

# Runs a command in the current pane, or in a new tmux window when the menu is a popup.
run_here() {
  local name=$1
  shift
  if ((POPUP)) && [[ -n ${TMUX:-} ]]; then
    tmux new-window -n "$name" "$@"
    exit 0
  fi
  "$@" || true
}

start_agent() {
  local agent=${1:-}
  if [[ -z $agent ]]; then
    agent=$(rescue-config state 2>/dev/null | jq -r '.agent // "opencode"')
  fi
  if [[ $agent != claude && $agent != codex ]] && ! providers_configured; then
    gum style --foreground "#e0af68" "  No AI provider is configured yet."
    if gum confirm "Connect one now?"; then
      rescue-connect || true
    fi
    providers_configured || return 0
  fi
  case $agent in
  opencode | claude | codex) run_here "$agent" "$agent" ;;
  *)
    echo "unknown agent: $agent" >&2
    return 1
    ;;
  esac
}

menu() {
  local first=${1:-0} choice mounted agent
  while true; do
    if ((first)); then
      first=0
    else
      clear
      welcome
    fi
    mounted="Find and mount the installed system"
    if mountpoint -q /mnt; then mounted="Unmount the installed system"; fi
    choice=$(gum choose --height 13 --header "  What do you want to do?" \
      "Talk to an agent" \
      "Connect an AI provider" \
      "Connect to Wi-Fi" \
      "$mounted" \
      "Open a shell inside the installed system" \
      "Share this console with a phone" \
      "Save keys on this stick" \
      "Hardware overview" \
      "Exit to the shell" \
      "Reboot" \
      "Power off") || return 0
    case $choice in
    "Talk to an agent")
      agent=$(gum choose --header "  Which agent?" "opencode" "claude" "codex") || continue
      start_agent "$agent"
      ;;
    "Connect an AI provider") rescue-connect || true ;;
    "Connect to Wi-Fi") run_here wifi impala ;;
    "Find and mount the installed system")
      rescue-mount || true
      pause
      ;;
    "Unmount the installed system")
      rescue-mount --unmount || true
      pause
      ;;
    "Open a shell inside the installed system")
      if ! mountpoint -q /mnt; then
        rescue-mount || { pause; continue; }
      fi
      if findmnt -n -o OPTIONS /mnt | grep -qw ro && gum confirm "Remount writable so repairs are possible?"; then
        rescue-mount --unmount && rescue-mount --rw
      fi
      run_here chroot rescue-enter
      ;;
    "Share this console with a phone")
      rescue-share || true
      pause
      ;;
    "Save keys on this stick")
      rescue-persist || true
      pause
      ;;
    "Hardware overview")
      { fastfetch 2>/dev/null; inxi -Fxz 2>/dev/null; } | less -R
      ;;
    "Exit to the shell") return 0 ;;
    "Reboot")
      if gum confirm "Reboot now?"; then
        rescue-mount --unmount >/dev/null 2>&1 || true
        systemctl reboot
      fi
      ;;
    "Power off")
      if gum confirm "Power off now?"; then
        rescue-mount --unmount >/dev/null 2>&1 || true
        systemctl poweroff
      fi
      ;;
    esac
  done
}

# Give DHCP a moment on first boot so the status line is not "offline" for nothing.
wait_for_network() {
  local link carrier=0
  for link in /sys/class/net/*; do
    [[ ${link##*/} == lo ]] && continue
    if [[ $(cat "$link/carrier" 2>/dev/null) == 1 ]]; then carrier=1; fi
  done
  ((carrier)) || return 0
  for _ in $(seq 1 16); do
    if ip -4 route get 1.1.1.1 >/dev/null 2>&1; then return 0; fi
    sleep 0.5
  done
  return 0
}

case ${1:-menu} in
menu)
  menu 0
  ;;
boot)
  wait_for_network
  clear
  welcome
  menu 1
  clear
  welcome
  show_help
  ;;
welcome) welcome ;;
help) show_help ;;
keys) keys ;;
agent) start_agent "${2:-}" ;;
-h | --help) sed -n '2,8p' "$0" ;;
*)
  echo "unknown command: $1 (try rescue --help)" >&2
  exit 1
  ;;
esac
