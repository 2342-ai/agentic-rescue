#!/usr/bin/env python3
"""rescue-config: turn the configuration slot into agent, network and console configuration.

Sources, later ones override earlier ones (dicts are merged, lists replaced):
  1. /iso/rescue-config.json            the slot in the ISO image
  2. /persist/rescue-config.json        writable RESCUE_DATA partition, if present
  3. /run/agentic-rescue/runtime.json   values entered at runtime (rescue-connect)

Commands:
  rescue-config apply                    write everything (runs at boot as root)
  rescue-config show                     merged configuration, secrets masked
  rescue-config get KEY                  dotted key, e.g. model
  rescue-config set KEY VALUE [--persist] set a value at runtime and re-apply
  rescue-config unset KEY [--persist]
  rescue-config providers                known providers as JSON
  rescue-config refresh-models           ask providers with a /models endpoint for their catalog
  rescue-config state                    what is configured, as JSON (used by the menu)

Options:
  --root DIR   operate below DIR instead of / (used by the checks)
"""

import json
import os
import re
import shlex
import subprocess
import sys
import urllib.error
import urllib.request

SLOT_MAGIC = "agentic-rescue-config-v1"
AGENTS_MD = "/etc/agentic-rescue/AGENTS.md"

# One table for everything the system knows about a provider.
#   env:      environment variable the agents read the key from
#   opencode: "builtin" (opencode knows it from models.dev) or a custom provider block
#   claude:   how Claude Code reaches it (direct = ANTHROPIC_API_KEY, proxy = base_url + auth token)
#   codex:    how Codex reaches it (direct = OPENAI_API_KEY, proxy = custom model_provider)
PROVIDERS = {
    "2342ai": {
        "label": "2342.ai",
        "env": "AI2342_API_KEY",
        "url": "https://2342.ai",
        "free": False,
        "opencode": {
            "npm": "@ai-sdk/openai-compatible",
            "baseURL": "https://2342.ai/v1",
        },
        "models_endpoint": "https://2342.ai/v1/models",
        "models": [
            "claude-sonnet-4-5",
            "claude-opus-4-5",
            "gpt-5.4",
            "gpt-5.3-codex",
            "gemini-3.5-flash",
            "glm-5.2",
        ],
        "default_model": "claude-sonnet-4-5",
        "claude": {"proxy": "https://2342.ai", "model": "claude-sonnet-4-5"},
        "codex": {"proxy": "https://2342.ai/v1", "model": "gpt-5.3-codex"},
    },
    "groq": {
        "label": "Groq",
        "env": "GROQ_API_KEY",
        "url": "https://console.groq.com/keys",
        "free": True,
